{
  "name": "camera-node (ESP-IDF v6.1)",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "dev",
  // workspaceMount is passed to `docker run --mount`, which has no SELinux relabel
  // option (",z" is rejected). Mount via -v with :z instead so it works on
  // SELinux-enforcing hosts (Fedora/RHEL); the empty workspaceMount skips the default.
  "workspaceMount": "",
  "workspaceFolder": "/workspace",

  // Serial access for flashing from inside the container (Linux hosts).
  // /dev is bind-mounted so the board can be unplugged and replugged without
  // restarting the container. Windows/macOS: flash from the host instead (see README).
  "runArgs": ["--privileged", "-v", "${localWorkspaceFolder}:/workspace:z"],
  "mounts": ["source=/dev,target=/dev,type=bind"],

  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "idf.espIdfPath": "/opt/esp/idf",
        "idf.toolsPath": "/opt/esp",
        "idf.gitPath": "/usr/bin/git"
      },
      "extensions": [
        "espressif.esp-idf-extension",
        "ms-vscode.cpptools"
      ]
    }
  }
}
