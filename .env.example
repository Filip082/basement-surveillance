# Copy to .env and adjust:  cp .env.example .env
# .env is gitignored — never commit real secrets.
# Every service in docker-compose.yml loads this file.

# Database
POSTGRES_DB=surveillance
POSTGRES_USER=surveillance
POSTGRES_PASSWORD=change-me

# Backend
PORT=8000
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
IMAGE_DIR=/data/images
IMAGE_MAX_BYTES=10485760
IMAGE_DOWNLOAD_TIMEOUT_MS=15000

# Frontend (Vite dev server; /api is forwarded to the backend over the compose network)
FRONTEND_PORT=5173
API_PROXY_TARGET=http://backend:${PORT}

#tu na razie jest ściernisko ale będzie adres routera
ROUTER_IMAGE_URL=http://backend:8000/test/images
ROUTER_BASE_URL=http://192.168.1.100