/*
 * nRF5340 DK alternate board configuration.
 * Button 1 (P0.23) can simulate the PIR input for development.
 * The test-only battery button/trigger has been removed.
 * Camera wake output remains on P1.04 (active LOW).
 */

/ {
    zephyr,user {
        pir-gpios = <&gpio0 23 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
        cam-wake-gpios = <&gpio1 4 GPIO_ACTIVE_LOW>;
    };
};
