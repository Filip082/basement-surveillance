/*
 * Wio-SX1262 LoRa module on the XIAO nRF52840.
 *
 * Module stacked on the XIAO pin headers, as shipped in Seeed's
 * "XIAO nRF52840 + Wio-SX1262" kit (same pinout as Meshtastic variant
 * seeed_xiao_nrf52840_kit). The Wio-SX1262 from the XIAO ESP32-S3 kit is wired
 * differently, so don't swap modules between kits without changing these pins.
 */

#include <zephyr/dt-bindings/lora/sx126x.h>

#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>
#include <zephyr/dt-bindings/i2c/i2c.h>

/ {
	aliases {
		lora0 = &lora0;
	};
};

&xiao_spi {
	status = "okay";
	cs-gpios = <&xiao_d 4 GPIO_ACTIVE_LOW>;		/* D4: NSS */

	lora0: lora@0 {
		compatible = "semtech,sx1262";
		reg = <0>;
		spi-max-frequency = <DT_FREQ_M(8)>;
		reset-gpios = <&xiao_d 2 GPIO_ACTIVE_LOW>;	/* D2 */
		busy-gpios = <&xiao_d 3 GPIO_ACTIVE_HIGH>;	/* D3 */
		dio1-gpios = <&xiao_d 1 GPIO_ACTIVE_HIGH>;	/* D1 */
		rx-enable-gpios = <&xiao_d 5 GPIO_ACTIVE_HIGH>;	/* D5: RF switch RX side */
		dio2-tx-enable;					/* DIO2 drives RF switch TX side */
		dio3-tcxo-voltage = <SX126X_DIO3_TCXO_1V8>;
		tcxo-power-startup-delay-ms = <5>;
	};
};

/*
 * D6=P1.11 (SDA), D7=P1.12 (SCL) - dedicated to PCF8575 I2C.
 * D0=P0.02 - PCF8575 /INT (active LOW, open drain, external 4.7k pull-up).
 * PIR output -> PCF8575 P04, HIGH means motion.
 * PCF8575 P06 - camera-node wake (active LOW, 30 ms picture / 80 ms noon).
 *
 * IMPORTANT: PCF8575 /INT is not a copied PIR HIGH level; it asserts LOW
 * when an input changes. Zephyr's PCF857x driver configures D0 as an IRQ,
 * reads PCF inputs over I2C and dispatches callbacks on changed pins.
 */

&pinctrl {
    i2c1_custom_default: i2c1_custom_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 1, 11)>,
                    <NRF_PSEL(TWIM_SCL, 1, 12)>;
            bias-pull-up;
        };
    };

    i2c1_custom_sleep: i2c1_custom_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 1, 11)>,
                    <NRF_PSEL(TWIM_SCL, 1, 12)>;
            low-power-enable;
            bias-pull-up;
        };
    };
};

/* D6 and D7 are TWIM pins now, not UART0. USB CDC ACM stays enabled. */
&uart0 {
    status = "disabled";
};

/* Konfiguracja magistrali I2C */
&xiao_i2c {
    status = "okay";
    clock-frequency = <100000>;

    pinctrl-0 = <&i2c1_custom_default>;
    pinctrl-1 = <&i2c1_custom_sleep>;
    pinctrl-names = "default", "sleep";

    pcf8575: pcf8575@20 {
        compatible = "nxp,pcf857x";
        reg = <0x20>;
        gpio-controller;
        #gpio-cells = <2>;
        ngpios = <16>;
        /* PCF8575 INT -> XIAO D0. IRQ serviced by the expander driver. */
        int-gpios = <&xiao_d 0 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
        status = "okay";
    };
};

/ {
	zephyr,user {
		pir-gpios = <&pcf8575 4 GPIO_ACTIVE_HIGH>;
		cam-wake-gpios = <&pcf8575 6 GPIO_ACTIVE_LOW>;
	};
};
